rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin SDK maintains this mapping; clients cannot manufacture membership.
    function userId() {
      return get(/databases/$(database)/documents/userIdentities/$(request.auth.uid)).data.userId;
    }
    function activeIdentity() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/userIdentities/$(request.auth.uid)) &&
        !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }
    function isMember(conversationId) {
      return activeIdentity() && userId() in
        get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
    }
    match /conversations/{conversationId} {
      // Queries must constrain memberIds to the authenticated database user ID.
      allow read: if activeIdentity() && userId() in resource.data.memberIds;
      allow write: if false;
      match /messages/{messageId} {
        allow read: if isMember(conversationId);
        allow write: if false;
      }
      match /members/{memberId} {
        allow read: if isMember(conversationId);
        allow write: if false;
      }
      match /watchRequests/{requestId} {
        allow read: if isMember(conversationId);
        allow write: if false;
        match /responses/{responseId} {
          allow read: if isMember(conversationId);
          allow write: if false;
        }
      }
    }
    // Identity mappings, deletion jobs and other collections are server-only.
    match /{document=**} { allow read, write: if false; }
  }
}
