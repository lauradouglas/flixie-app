{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "flixie-app (Chrome - Local Firebase)",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file",
                ".firebase.local.json"
            ],
            "args": [
                "-d",
                "chrome",
                "--web-port=5000"
            ],
            "preLaunchTask": "Flixie: start local services"
        },
        {
            "name": "flixie-app (Web - Local Firebase)",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file",
                ".firebase.local.json"
            ],
            "args": [
                "-d",
                "web-server",
                "--web-port=5000"
            ],
            "preLaunchTask": "Flixie: start local services"
        },
        {
            "name": "flixie-app (Mobile - Local Firebase)",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file",
                ".firebase.local.json"
            ],
            "preLaunchTask": "Flixie: start local services"
        },
        {
            "name": "flixie-app (Android Emulator - Local Firebase)",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file",
                ".firebase.local.json",
                "--dart-define=FIREBASE_EMULATOR_HOST=10.0.2.2",
                "--dart-define=API_BASE_URL=http://10.0.2.2:3000"
            ],
            "preLaunchTask": "Flixie: start local services"
        },
        {
            "name": "flixie-app (Chrome)",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file",
                ".firebase.local.json"
            ],
            "args": [
                "-d",
                "chrome",
                "--web-port=5000"
            ],
            "preLaunchTask": "Flixie: start local services"
        },
        {
            "name": "flixie-app (Local Web)",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file",
                ".firebase.local.json"
            ],
            "args": [
                "-d",
                "web-server",
                "--web-port=5000"
            ],
            "preLaunchTask": "Flixie: start local services"
        },
        {
            "name": "flixie-app (Profile - Production)",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define-from-file",
                ".firebase.json",
                "--dart-define=USE_FIREBASE_EMULATORS=false",
                "--dart-define=USE_PROD_API=true"
            ],
            "flutterMode": "profile"
        }
    ]
}
